{
  // packages-worker (STANDALONE DEV COPY — DO NOT DEPLOY, see name below)
  // UnitedSys — United Systems | jwl247
  //
  // DEFUSED 2026-09-13: this repo used to share the worker name "packages-
  // worker" with Phoenix-DevOps-oS/sector2/package-handler/worker/ — the
  // ACTUAL live one (last real deploy confirmed 2026-09-05 via
  // `wrangler deployments list`, matching that session's own log). Same
  // name meant `wrangler deploy` from EITHER repo overwrote the same live
  // target. This repo's code was 622 lines behind at the time (no
  // integrity system, no QR gen, no suite-execution gate wiring) — a
  // deploy from here would have silently destroyed months of monorepo-only
  // work. Renamed below so that can't happen even by accident.
  //
  // If this repo is ever revived as something real, rename it back
  // deliberately and confirm with Jerry first — don't just delete this
  // comment and "name" override without understanding why they're here.
  //
  // Tail:   wrangler tail (now tails the harmless standalone name, not prod)
  // Secret: wrangler secret put PHOENIX_AUTH (harmless — different worker)

  "name": "packages-worker-standalone-DO-NOT-DEPLOY-see-comment",
  "main": "index.js",
  "compatibility_date": "2025-01-01",

  // ── D1 Binding ─────────────────────────────────────────────────────────────
  // PHOENIX_DB → phoenix_dev_db (the backbone — all tables live here)
  "d1_databases": [
    {
      "binding":       "PHOENIX_DB",
      "database_name": "phoenix_dev_db",
      "database_id":   "27958687-4349-47ed-8b6a-dbc4ab29730f"
    }
  ],

  // ── R2 Binding ─────────────────────────────────────────────────────────────
  // CLONEPOOL_BUCKET → phoenix-clonepool (the actual file bytes live here;
  // D1's clonepool table is metadata/catalog only, R2 is the real clonepool)
  "r2_buckets": [
    {
      "binding":     "CLONEPOOL_BUCKET",
      "bucket_name": "phoenix-clonepool"
    }
  ]

  // ── Secrets ────────────────────────────────────────────────────────────────
  // PHOENIX_AUTH — set via: wrangler secret put PHOENIX_AUTH
  // Never put the token here — secrets only
}
